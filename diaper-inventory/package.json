{
  "name": "little-stock",
  "description": "Owner-only diaper shop inventory, sales and daily reports",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "firebase": "12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --project demo-little-stock --only firestore,storage \"tsx --test tests/rules/*.test.ts\""
  },
  "private": true
}
